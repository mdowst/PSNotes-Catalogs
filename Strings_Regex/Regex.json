      ],
      "Run": false,
      "Kind": 0
    },
    {
      "Name": "Find URL in String",
      "Snippet": "[Regex]::Matches($string, '((https?|ftp|file):\\/\\/)?([\\da-z\\.-]+)\\.([a-z\\.]{2,6})([\\/\\w \\.-](.*?)(?=\\s))').Value",
      "Details": "Match URL with optional protocol",
      "Alias": "find-url-in-string",
      "Tags": [
        "regex",
        "string"
      ],
      "Run": false,
      "Kind": 0
    },
    {
      "Name": "Find Email Address in String",
      "Snippet": "$emailRegex = @\"\n(?:[a-z0-9!#$%&amp;'*+/=?^_`{|}~-]+(?:\\.[a-z0-9!#$%&amp;'*+/=?^_`{|}~-]+)*|\"(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21\\x23-\\x5b\\x5d-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])*\")@(?:(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?|\\[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[a-z0-9-]*[a-z0-9]:(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21-\\x5a\\x53-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])+)\\])\n\"@\n[Regex]::Matches($string, $emailRegex).Value",
      "Details": "This regex example will extract any and all email addresses from a string.",
      "Alias": "find-email-address-in-string",
      "Tags": [
        "regex",
        "string"
      ],
      "Run": false,
      "Kind": 0
    },
    {
      "Name": "Find Guid in String",
      "Snippet": "$guidPattern = \"(\\{){0,1}[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}(\\}){0,1}\"\n[Regex]::Matches($string, $guidPattern).Value",
      "Details": "Uses regex to return a Guid inside of a string.",
      "Alias": "find-guid-in-string",
      "Tags": [
        "guid",
        "regex"
      ],
      "Run": false,
      "Kind": 0
    },
    {
