      "Details": "Match IP v6 addresses",
      "Alias": "find-ipv6-address-in-string",
      "Tags": [
        "ip-address",
        "regex",
        "string"
      ],
      "Run": false,
      "Kind": 0
    },
    {
      "Name": "Find IPv4 Address in String",
      "Snippet": "[Regex]::Matches($string, '(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)').Value",
      "Details": "Match IP v4 addresses",
      "Alias": "find-ipv4-address-in-string",
