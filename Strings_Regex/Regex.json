  "Notes": [
    {
      "Name": "Find Specific Word in String",
      "Snippet": "[Regex]::Matches($string, '(?:^|\\b)words(?:$|\\b)')",
      "Details": "Matches only the specific word in the express. In this case words will return, but passwords will not.",
      "Alias": "find-specific-word-in-string",
      "Tags": [
        "regex",
        "string"
      ],
      "Run": false,
      "Kind": 0
    },
    {
      "Name": "Find Date in MM/DD/YYYY Pattern in String",
      "Snippet": "[Regex]::Matches($string, '(((0?[1-9]|1[012])/(0?[1-9]|1\\d|2[0-8])|(0?[13456789]|1[012])/(29|30)|(0?[13578]|1[02])/31)/(19|[2-9]\\d)\\d{2}|0?2/29/((19|[2-9]\\d)(0[48]|[2468][048]|[13579][26])|(([2468][048]|[3579][26])00)))').Value",
      "Details": "List any and all valid dates since year 1900. MM and DD can have 1 or 2 digits",
      "Alias": "find-date-in-mm-dd-yyyy-pattern-in-string",
      "Tags": [
        "datetime",
        "regex",
        "string"
      ],
      "Run": false,
      "Kind": 0
    },
    {
      "Name": "Find US Phone Number in String",
      "Snippet": "[Regex]::Matches($string, '((\\(\\d{3}\\) ?)|(\\d{3}-))?\\d{3}-\\d{4}').Value",
      "Details": "List US phone numbers found in a string",
      "Alias": "find-us-phone-number-in-string",
      "Tags": [
        "regex",
        "string"
      ],
      "Run": false,
      "Kind": 0
    },
    {
      "Name": "Find Numbers in String",
      "Snippet": "[Regex]::Matches($string, '-?\\d*\\.?\\d+').Value",
      "Details": "List integers or floats that are positive or negative inside a string",
      "Alias": "find-numbers-in-string",
      "Tags": [
        "regex",
        "string"
      ],
      "Run": false,
      "Kind": 0
    },
    {
